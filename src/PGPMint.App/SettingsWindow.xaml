<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="PGPMint.App.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:PGPMint.App.ViewModels"
    Title="PGPMint - Settings">

    <Grid x:Name="RootLayout" RowDefinitions="38,*" SizeChanged="OnRootLayoutSizeChanged">
        <Grid x:Name="TitleBarDragArea" Grid.Row="0" Padding="16,0,144,0" Background="Transparent">
            <TextBlock Text="{x:Bind ViewModel.Loc.Settings, Mode=OneWay}"
                       FontSize="13"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center" />
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="SettingsContentPanel"
                        VerticalAlignment="Top"
                        Padding="16,6,16,16"
                        Spacing="12"
                        SizeChanged="OnSettingsContentSizeChanged">

                <!-- 1. Language (Top Row, Extensible Dropdown) -->
                <Border Style="{StaticResource SurfaceCardStyle}">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <TextBlock Grid.Column="0"
                                   Text="{x:Bind ViewModel.Loc.SectionLanguage, Mode=OneWay}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                        <ComboBox x:Name="LanguageComboBox"
                                  Grid.Column="1"
                                  MinWidth="184"
                                  DisplayMemberPath="DisplayName"
                                  SelectedValuePath="Code"
                                  SelectionChanged="OnLanguageSelectionChanged" />
                    </Grid>
                </Border>

                <!-- 2. Target Key ID Suffix Card (No speculative speed/ETA) -->
                <Border Style="{StaticResource SurfaceCardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="{x:Bind ViewModel.Loc.SectionTarget, Mode=OneWay}"
                                   FontSize="13"
                                   FontWeight="SemiBold" />

                        <TextBlock Text="{x:Bind ViewModel.DraftFormattedPreview, Mode=OneWay}"
                                   FontFamily="{StaticResource MonoFont}"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   CharacterSpacing="40"
                                   HorizontalAlignment="Center" />

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Border x:Name="SettingsInputFrame" Grid.Column="0" CornerRadius="6" BorderThickness="1.5" BorderBrush="Transparent">
                                <TextBox x:Name="SettingsTargetInputBox"
                                         Text="{x:Bind ViewModel.DraftTargetInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         PlaceholderText="{x:Bind ViewModel.Loc.TargetPlaceholder, Mode=OneWay}"
                                         IsEnabled="{x:Bind ViewModel.CanEditTarget, Mode=OneWay}"
                                         FontFamily="{StaticResource MonoFont}"
                                         FontSize="15"
                                         MaxLength="24"
                                         TextAlignment="Center" />
                            </Border>
                            <Button Grid.Column="1"
                                    Content="{x:Bind ViewModel.Loc.Apply, Mode=OneWay}"
                                    Style="{StaticResource AccentButtonStyle}"
                                    MinWidth="76"
                                    IsEnabled="{x:Bind ViewModel.CanApplyDraftTarget, Mode=OneWay}"
                                    Click="OnApplyTargetClick" />
                        </Grid>

                        <TextBlock x:Name="SettingsValidationErrorText"
                                   Text="{x:Bind ViewModel.DraftErrorText, Mode=OneWay}"
                                   Foreground="#EF4444"
                                   FontSize="12"
                                   Visibility="Collapsed" />

                        <TextBlock x:Name="StopToEditNotice"
                                   Text="{x:Bind ViewModel.Loc.StopToEditHint, Mode=OneWay}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   FontSize="12"
                                   Visibility="Collapsed" />

                        <TextBlock Text="{x:Bind ViewModel.Loc.SuffixRuleHint, Mode=OneWay}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   FontSize="12"
                                   TextWrapping="Wrap" />

                        <TextBlock Text="{x:Bind ViewModel.Loc.SettingTimestampRange, Mode=OneWay}"
                                   FontSize="12.5"
                                   FontWeight="SemiBold"
                                   Margin="0,4,0,0" />

                        <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="8">
                            <TextBox Grid.Column="0"
                                     Text="{x:Bind ViewModel.DraftMinCreationDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     PlaceholderText="{x:Bind ViewModel.Loc.SettingTimestampSincePlaceholder, Mode=OneWay}"
                                     IsEnabled="{x:Bind ViewModel.CanEditTarget, Mode=OneWay}"
                                     FontFamily="{StaticResource MonoFont}"
                                     FontSize="12.5" />
                            <TextBox Grid.Column="1"
                                     Text="{x:Bind ViewModel.DraftMaxCreationDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     PlaceholderText="{x:Bind ViewModel.Loc.SettingTimestampUntilPlaceholder, Mode=OneWay}"
                                     IsEnabled="{x:Bind ViewModel.CanEditTarget, Mode=OneWay}"
                                     FontFamily="{StaticResource MonoFont}"
                                     FontSize="12.5" />
                            <Button Grid.Column="2"
                                    Content="{x:Bind ViewModel.Loc.Apply, Mode=OneWay}"
                                    MinWidth="76"
                                    IsEnabled="{x:Bind ViewModel.CanEditTarget, Mode=OneWay}"
                                    Click="OnApplyTimestampRangeClick" />
                        </Grid>

                        <TextBlock x:Name="TimestampRangeErrorText"
                                   Text="{x:Bind ViewModel.TimestampRangeErrorText, Mode=OneWay}"
                                   Foreground="#EF4444"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Visibility="Collapsed" />
                    </StackPanel>
                </Border>

                <!-- 3. Preferences Card (Responsive 1-column / 2-column grid based on window width) -->
                <Border Style="{StaticResource SurfaceCardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="{x:Bind ViewModel.Loc.SectionPreferences, Mode=OneWay}"
                                   FontSize="13"
                                   FontWeight="SemiBold" />

                        <Grid x:Name="PreferencesGrid" ColumnSpacing="16" RowSpacing="8">
                            <ToggleSwitch x:Name="PrefAutoPause"
                                          Header="{x:Bind ViewModel.Loc.SettingAutoPauseOnHit, Mode=OneWay}"
                                          IsOn="{x:Bind ViewModel.AutoPauseOnHit, Mode=TwoWay}"
                                          OnContent="" OffContent="" MinWidth="0" />

                            <ToggleSwitch x:Name="PrefMinimizeToTray"
                                          Header="{x:Bind ViewModel.Loc.SettingMinimizeToTray, Mode=OneWay}"
                                          IsOn="{x:Bind ViewModel.MinimizeToTrayOnClose, Mode=TwoWay}"
                                          OnContent="" OffContent="" MinWidth="0" />

                            <ToggleSwitch x:Name="PrefShowMiniHud"
                                          Header="{x:Bind ViewModel.Loc.SettingShowMiniHud, Mode=OneWay}"
                                          IsOn="{x:Bind ViewModel.ShowMiniHudInTray, Mode=TwoWay}"
                                          OnContent="" OffContent="" MinWidth="0" />

                            <ToggleSwitch x:Name="PrefStartWithWindows"
                                          Header="{x:Bind ViewModel.Loc.SettingStartWithWindows, Mode=OneWay}"
                                          IsOn="{x:Bind ViewModel.StartWithWindows, Mode=TwoWay}"
                                          OnContent="" OffContent="" MinWidth="0" />
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <TextBlock Grid.Column="0"
                                       Text="{x:Bind ViewModel.Loc.SettingMaxGpuTemp, Mode=OneWay}"
                                       FontSize="13"
                                       VerticalAlignment="Center" />
                            <ComboBox x:Name="MaxGpuTempComboBox"
                                      Grid.Column="1"
                                      MinWidth="128"
                                      DisplayMemberPath="DisplayName"
                                      SelectedValuePath="LimitValue"
                                      SelectionChanged="OnMaxGpuTempSelectionChanged" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 4. Hardware GPUs Card (Selection & manual curve recalibration) -->
                <Border Style="{StaticResource SurfaceCardStyle}">
                    <StackPanel Spacing="10">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBlock Grid.Column="0"
                                       Text="{x:Bind ViewModel.Loc.SectionGpus, Mode=OneWay}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                            <Button x:Name="RecalibrateButton"
                                    Grid.Column="1"
                                    Content="{x:Bind ViewModel.Loc.Recalibrate, Mode=OneWay}"
                                    FontSize="12"
                                    Padding="10,4"
                                    IsEnabled="{x:Bind ViewModel.CanRecalibrate, Mode=OneWay}"
                                    Click="OnRecalibrateClick" />
                        </Grid>

                        <ItemsControl ItemsSource="{x:Bind ViewModel.Gpus}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="6" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:GpuItemViewModel">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" MinHeight="28">
                                        <CheckBox Grid.Column="0"
                                                  IsChecked="{x:Bind IsEnabled, Mode=OneWay}"
                                                  IsEnabled="{x:Bind CanToggle, Mode=OneWay}"
                                                  MinWidth="0"
                                                  Padding="0"
                                                  Tag="{x:Bind DeviceKey}"
                                                  Click="OnGpuToggleClick" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                            <TextBlock Text="{x:Bind Name}"
                                                       FontSize="13"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind StatusSummary, Mode=OneWay}"
                                                       Visibility="{x:Bind StatusSummaryVisibility, Mode=OneWay}"
                                                       FontSize="11"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Border Grid.Column="2"
                                                CornerRadius="4"
                                                Padding="6,2"
                                                VerticalAlignment="Center"
                                                Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                            <TextBlock Text="{x:Bind BackendName, Mode=OneWay}"
                                                       FontFamily="{StaticResource MonoFont}"
                                                       FontSize="11"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- 5. Progress & Vault Sync Card -->
                <Border Style="{StaticResource SurfaceCardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="{x:Bind ViewModel.Loc.SectionSync, Mode=OneWay}"
                                   FontSize="13"
                                   FontWeight="SemiBold" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <Button Grid.Column="0"
                                    HorizontalAlignment="Stretch"
                                    Content="{x:Bind ViewModel.Loc.SyncExportButton, Mode=OneWay}"
                                    Click="OnExportSyncClick" />
                            <Button Grid.Column="1"
                                    HorizontalAlignment="Stretch"
                                    Content="{x:Bind ViewModel.Loc.SyncImportButton, Mode=OneWay}"
                                    Click="OnImportSyncClick" />
                        </Grid>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
