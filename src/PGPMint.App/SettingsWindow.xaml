<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="PGPMint.App.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:PGPMint.App.ViewModels"
    Title="PGPMint - Settings">

    <Grid RowDefinitions="38,*">
        <Grid x:Name="TitleBarDragArea" Grid.Row="0" Padding="16,0,144,0" Background="Transparent">
            <TextBlock Text="{x:Bind ViewModel.Loc.Settings, Mode=OneWay}"
                       FontSize="13"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center" />
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="16,6,16,16" Spacing="12">

                <!-- 1. Target Key ID Suffix Card -->
                <Border Style="{StaticResource SurfaceCardStyle}">
                    <StackPanel Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{x:Bind ViewModel.Loc.SectionTarget, Mode=OneWay}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                            <Border x:Name="SettingsEtaPill"
                                    Grid.Column="1"
                                    Style="{StaticResource EtaPillStyle}">
                                <TextBlock Text="{x:Bind ViewModel.DraftEtaText, Mode=OneWay}"
                                           FontFamily="{StaticResource MonoFont}"
                                           FontSize="13"
                                           FontWeight="SemiBold" />
                            </Border>
                        </Grid>

                        <TextBlock Text="{x:Bind ViewModel.DraftFormattedPreview, Mode=OneWay}"
                                   FontFamily="{StaticResource MonoFont}"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   CharacterSpacing="40"
                                   HorizontalAlignment="Center" />

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Border x:Name="SettingsInputFrame" Grid.Column="0" CornerRadius="6" BorderThickness="1.5" BorderBrush="Transparent">
                                <TextBox x:Name="SettingsTargetInputBox"
                                         Text="{x:Bind ViewModel.DraftTargetInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         PlaceholderText="{x:Bind ViewModel.Loc.TargetPlaceholder, Mode=OneWay}"
                                         IsEnabled="{x:Bind ViewModel.CanEditTarget, Mode=OneWay}"
                                         FontFamily="{StaticResource MonoFont}"
                                         FontSize="15"
                                         MaxLength="24"
                                         TextAlignment="Center" />
                            </Border>
                            <Button Grid.Column="1"
                                    Content="{x:Bind ViewModel.Loc.Apply, Mode=OneWay}"
                                    Style="{StaticResource AccentButtonStyle}"
                                    MinWidth="76"
                                    IsEnabled="{x:Bind ViewModel.CanApplyDraftTarget, Mode=OneWay}"
                                    Click="OnApplyTargetClick" />
                        </Grid>

                        <TextBlock x:Name="SettingsValidationErrorText"
                                   Text="{x:Bind ViewModel.DraftErrorText, Mode=OneWay}"
                                   Foreground="#EF4444"
                                   FontSize="12"
                                   Visibility="Collapsed" />

                        <TextBlock x:Name="StopToEditNotice"
                                   Text="{x:Bind ViewModel.Loc.StopToEditHint, Mode=OneWay}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   FontSize="12"
                                   Visibility="Collapsed" />

                        <TextBlock Text="{x:Bind ViewModel.Loc.SuffixRuleHint, Mode=OneWay}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   FontSize="12"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- 2. Hardware GPUs & 30s Calibration Card -->
                <Border Style="{StaticResource SurfaceCardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="{x:Bind ViewModel.Loc.SectionGpus, Mode=OneWay}"
                                   FontSize="13"
                                   FontWeight="SemiBold" />

                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.Gpus}">
                            <ItemsRepeater.Layout>
                                <StackLayout Spacing="6" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:GpuItemViewModel">
                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8" MinHeight="28">
                                        <CheckBox Grid.Column="0"
                                                  IsChecked="{x:Bind IsEnabled, Mode=OneWay}"
                                                  IsEnabled="{x:Bind CanToggle, Mode=OneWay}"
                                                  MinWidth="0"
                                                  Padding="0"
                                                  Tag="{x:Bind DeviceKey}"
                                                  Click="OnGpuToggleClick" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{x:Bind Name}"
                                                   FontSize="13"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" />
                                        <Border Grid.Column="2"
                                                CornerRadius="4"
                                                Padding="6,2"
                                                VerticalAlignment="Center"
                                                Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                            <TextBlock Text="{x:Bind BackendName, Mode=OneWay}"
                                                       FontFamily="{StaticResource MonoFont}"
                                                       FontSize="11"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </Border>
                                        <TextBlock Grid.Column="3"
                                                   Text="{x:Bind RateText, Mode=OneWay}"
                                                   FontFamily="{StaticResource MonoFont}"
                                                   FontSize="13"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>

                        <Button Content="{x:Bind ViewModel.Loc.SettingRecalibrate30s, Mode=OneWay}"
                                HorizontalAlignment="Stretch"
                                IsEnabled="{x:Bind ViewModel.CanRecalibrate, Mode=OneWay}"
                                Click="OnRecalibrateClick" />
                    </StackPanel>
                </Border>

                <!-- 3. System Preferences Card -->
                <Border Style="{StaticResource SurfaceCardStyle}">
                    <StackPanel Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{x:Bind ViewModel.Loc.SettingLanguage, Mode=OneWay}"
                                       VerticalAlignment="Center"
                                       FontSize="13" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                <ToggleButton x:Name="LangZhButton" Content="繁中" Padding="10,4" FontSize="12" Click="OnLangZhClick" />
                                <ToggleButton x:Name="LangEnButton" Content="EN" Padding="10,4" FontSize="12" Click="OnLangEnClick" />
                            </StackPanel>
                        </Grid>

                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                        <ToggleSwitch Header="{x:Bind ViewModel.Loc.SettingAutoPauseOnHit, Mode=OneWay}"
                                      IsOn="{x:Bind ViewModel.AutoPauseOnHit, Mode=TwoWay}"
                                      OnContent="" OffContent="" MinWidth="0" />

                        <ToggleSwitch Header="{x:Bind ViewModel.Loc.SettingMinimizeToTray, Mode=OneWay}"
                                      IsOn="{x:Bind ViewModel.MinimizeToTrayOnClose, Mode=TwoWay}"
                                      OnContent="" OffContent="" MinWidth="0" />

                        <ToggleSwitch Header="{x:Bind ViewModel.Loc.SettingStartWithWindows, Mode=OneWay}"
                                      IsOn="{x:Bind ViewModel.StartWithWindows, Mode=TwoWay}"
                                      OnContent="" OffContent="" MinWidth="0" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
