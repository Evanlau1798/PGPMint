<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="PGPMint.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:PGPMint.App.ViewModels"
    Title="PGPMint">

    <Grid RowDefinitions="38,*">
        <!-- Compact Custom Title Bar -->
        <Grid x:Name="TitleBarRoot" Grid.Row="0" ColumnDefinitions="*,Auto" Padding="16,0,144,0">
            <StackPanel x:Name="TitleBarDragArea"
                        Grid.Column="0"
                        Orientation="Horizontal"
                        Spacing="8"
                        VerticalAlignment="Center"
                        Background="Transparent">
                <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#808080" VerticalAlignment="Center" />
                <TextBlock Text="PGPMint"
                           FontSize="13"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <TextBlock Text="{x:Bind ViewModel.TransientNotice, Mode=OneWay}"
                           FontSize="12"
                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                           VerticalAlignment="Center"
                           Margin="8,0,0,0" />
            </StackPanel>

            <Button x:Name="SettingsButton"
                    Grid.Column="1"
                    Style="{StaticResource IconGhostButtonStyle}"
                    ToolTipService.ToolTip="{x:Bind ViewModel.Loc.Settings, Mode=OneWay}"
                    AutomationProperties.Name="{x:Bind ViewModel.Loc.Settings, Mode=OneWay}"
                    Click="OnOpenSettingsClick">
                <FontIcon Glyph="&#xE713;" FontSize="14" />
            </Button>
        </Grid>

        <!-- Main Viewport -->
        <Grid Grid.Row="1" RowDefinitions="Auto,*" Padding="16,6,16,16">

            <!-- Hardware / Runtime Error Strip -->
            <Border x:Name="ErrorBanner"
                    Grid.Row="0"
                    Visibility="Collapsed"
                    Background="#28EF4444"
                    BorderBrush="#88EF4444"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12,8"
                    Margin="0,0,0,12"
                    SizeChanged="OnErrorBannerSizeChanged">
                <TextBlock Text="{x:Bind ViewModel.ErrorText, Mode=OneWay}"
                           FontSize="12"
                           TextWrapping="Wrap" />
            </Border>

            <!-- ==================== SETUP WIZARD (Single-Page First Launch) ==================== -->
            <ScrollViewer x:Name="SetupWizardPanel"
                          Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          Visibility="Collapsed">
                <StackPanel x:Name="SetupContentPanel"
                            VerticalAlignment="Top"
                            SizeChanged="OnSetupContentSizeChanged">
                    <Border Style="{StaticResource SurfaceCardStyle}" Padding="16">
                        <StackPanel Spacing="12">
                            <TextBlock Text="{x:Bind ViewModel.Loc.SetupTitle, Mode=OneWay}"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />

                            <TextBlock Text="{x:Bind ViewModel.DraftFormattedPreview, Mode=OneWay}"
                                       FontFamily="{StaticResource MonoFont}"
                                       FontSize="22"
                                       FontWeight="SemiBold"
                                       CharacterSpacing="40"
                                       HorizontalAlignment="Center"
                                       Margin="0,4,0,0" />

                            <StackPanel Spacing="6">
                                <Border x:Name="SetupInputFrame" CornerRadius="6" BorderThickness="1.5" BorderBrush="Transparent">
                                    <TextBox x:Name="SetupTargetInputBox"
                                             Text="{x:Bind ViewModel.DraftTargetInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             PlaceholderText="{x:Bind ViewModel.Loc.TargetPlaceholder, Mode=OneWay}"
                                             FontFamily="{StaticResource MonoFont}"
                                             FontSize="15"
                                             MaxLength="24"
                                             TextAlignment="Center" />
                                </Border>

                                <TextBlock x:Name="SetupValidationErrorText"
                                           Text="{x:Bind ViewModel.DraftErrorText, Mode=OneWay}"
                                           Foreground="#EF4444"
                                           FontSize="12"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           Visibility="Collapsed" />

                                <TextBlock Text="{x:Bind ViewModel.Loc.SuffixRuleHint, Mode=OneWay}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           FontSize="12"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                            <StackPanel Spacing="6">
                                <TextBlock Text="{x:Bind ViewModel.Loc.SectionGpus, Mode=OneWay}"
                                           FontSize="13"
                                           FontWeight="SemiBold" />

                                <ItemsControl ItemsSource="{x:Bind ViewModel.Gpus}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Spacing="6" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:GpuItemViewModel">
                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" MinHeight="28">
                                                <CheckBox Grid.Column="0"
                                                          IsChecked="{x:Bind IsEnabled, Mode=OneWay}"
                                                          IsEnabled="{x:Bind CanToggle, Mode=OneWay}"
                                                          MinWidth="0"
                                                          Padding="0"
                                                          Tag="{x:Bind DeviceKey}"
                                                          Click="OnGpuToggleClick" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{x:Bind Name}"
                                                           FontSize="13"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center" />
                                                <Border Grid.Column="2"
                                                        CornerRadius="4"
                                                        Padding="6,2"
                                                        VerticalAlignment="Center"
                                                        Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                                    <TextBlock Text="{x:Bind BackendName, Mode=OneWay}"
                                                               FontFamily="{StaticResource MonoFont}"
                                                               FontSize="11"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <TextBlock Grid.Column="0"
                                           Text="{x:Bind ViewModel.Loc.SectionLanguage, Mode=OneWay}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                                <ComboBox x:Name="SetupLanguageComboBox"
                                          Grid.Column="1"
                                          MinWidth="148"
                                          DisplayMemberPath="DisplayName"
                                          SelectedValuePath="Code"
                                          SelectionChanged="OnSetupLanguageSelectionChanged" />
                            </Grid>

                            <Button Content="{x:Bind ViewModel.Loc.Start, Mode=OneWay}"
                                    Style="{StaticResource AccentButtonStyle}"
                                    HorizontalAlignment="Stretch"
                                    Height="38"
                                    IsEnabled="{x:Bind ViewModel.CanFinishSetup, Mode=OneWay}"
                                    Click="OnSetupFinishClick" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ==================== MINIMALIST MAIN DASHBOARD ==================== -->
            <Grid x:Name="DashboardPanel"
                  Grid.Row="1"
                  RowDefinitions="Auto,Auto,*"
                  RowSpacing="12"
                  Visibility="Collapsed">

                <!-- 1. Live Speed, Current Target & 4-Tier Efficiency Card -->
                <Border Grid.Row="0" Style="{StaticResource SurfaceCardStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="{x:Bind ViewModel.ActiveFormattedPreview, Mode=OneWay}"
                                   FontFamily="{StaticResource MonoFont}"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   CharacterSpacing="40"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   HorizontalAlignment="Center" />

                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Bottom">
                                <TextBlock Text="{x:Bind ViewModel.ActualRateNumber, Mode=OneWay}"
                                           FontFamily="{StaticResource MonoFont}"
                                           FontSize="44"
                                           FontWeight="SemiBold"
                                           LineHeight="46" />
                                <TextBlock Text="{x:Bind ViewModel.ActualRateUnit, Mode=OneWay}"
                                           FontFamily="{StaticResource MonoFont}"
                                           FontSize="14"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           VerticalAlignment="Bottom"
                                           Margin="0,0,0,6" />
                            </StackPanel>

                            <Border x:Name="EfficiencyBadgeBorder"
                                    Grid.Column="1"
                                    VerticalAlignment="Bottom"
                                    Margin="0,0,0,6"
                                    CornerRadius="6"
                                    Padding="10,4"
                                    Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                    ToolTipService.ToolTip="{x:Bind ViewModel.EfficiencyBadgeTooltip, Mode=OneWay}">
                                <TextBlock x:Name="EfficiencyBadgeTextBlock"
                                           Text="{x:Bind ViewModel.EfficiencyBadgeText, Mode=OneWay}"
                                           FontFamily="{StaticResource MonoFont}"
                                           FontSize="13"
                                           FontWeight="SemiBold" />
                            </Border>
                        </Grid>

                        <Border x:Name="TierSelectorBorder"
                                CornerRadius="6"
                                Padding="3"
                                Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="1">
                            <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="3">
                                <Button x:Name="TierEcoButton"
                                        Grid.Column="0"
                                        Content="{x:Bind ViewModel.Loc.TierEco, Mode=OneWay}"
                                        Style="{StaticResource TierGhostButtonStyle}"
                                        HorizontalAlignment="Stretch"
                                        Height="30"
                                        Padding="4,0"
                                        FontSize="12.5"
                                        IsEnabled="{x:Bind ViewModel.IsTierSelectorEnabled, Mode=OneWay}"
                                        Tag="Eco"
                                        Click="OnTierButtonClick" />
                                <Button x:Name="TierBalancedButton"
                                        Grid.Column="1"
                                        Content="{x:Bind ViewModel.Loc.TierBalanced, Mode=OneWay}"
                                        Style="{StaticResource TierGhostButtonStyle}"
                                        HorizontalAlignment="Stretch"
                                        Height="30"
                                        Padding="4,0"
                                        FontSize="12.5"
                                        IsEnabled="{x:Bind ViewModel.IsTierSelectorEnabled, Mode=OneWay}"
                                        Tag="Balanced"
                                        Click="OnTierButtonClick" />
                                <Button x:Name="TierEfficiencyButton"
                                        Grid.Column="2"
                                        Content="{x:Bind ViewModel.Loc.TierEfficiency, Mode=OneWay}"
                                        Style="{StaticResource TierGhostButtonStyle}"
                                        HorizontalAlignment="Stretch"
                                        Height="30"
                                        Padding="4,0"
                                        FontSize="12.5"
                                        IsEnabled="{x:Bind ViewModel.IsTierSelectorEnabled, Mode=OneWay}"
                                        Tag="Efficiency"
                                        Click="OnTierButtonClick" />
                                <Button x:Name="TierMaxButton"
                                        Grid.Column="3"
                                        Content="{x:Bind ViewModel.Loc.TierMax, Mode=OneWay}"
                                        Style="{StaticResource AccentButtonStyle}"
                                        HorizontalAlignment="Stretch"
                                        Height="30"
                                        Padding="4,0"
                                        CornerRadius="4"
                                        FontSize="12.5"
                                        FontWeight="SemiBold"
                                        IsEnabled="{x:Bind ViewModel.IsTierSelectorEnabled, Mode=OneWay}"
                                        Tag="Max"
                                        Click="OnTierButtonClick" />
                            </Grid>
                        </Border>

                        <Button Content="{x:Bind ViewModel.PrimaryButtonText, Mode=OneWay}"
                                Style="{StaticResource AccentButtonStyle}"
                                HorizontalAlignment="Stretch"
                                Height="38"
                                IsEnabled="{x:Bind ViewModel.CanPrimaryAction, Mode=OneWay}"
                                Click="OnPrimaryActionClick" />
                    </StackPanel>
                </Border>

                <!-- 2. Progress & Telemetry Strip -->
                <Border Grid.Row="1" Style="{StaticResource SurfaceCardStyle}" Padding="16,12">
                    <StackPanel Spacing="8">
                        <ProgressBar Minimum="0"
                                     Maximum="100"
                                     Value="{x:Bind ViewModel.ProgressPercent, Mode=OneWay}"
                                     Height="6"
                                     CornerRadius="3" />

                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                            <TextBlock Grid.Column="0"
                                       Text="{x:Bind ViewModel.ProbabilityText, Mode=OneWay}"
                                       ToolTipService.ToolTip="{x:Bind ViewModel.SingleHashProbabilityTooltip, Mode=OneWay}"
                                       FontFamily="{StaticResource MonoFont}"
                                       FontSize="13"
                                       HorizontalAlignment="Left" />
                            <TextBlock Grid.Column="1"
                                       Text="{x:Bind ViewModel.CheckedCountText, Mode=OneWay}"
                                       ToolTipService.ToolTip="{x:Bind ViewModel.CheckedCountTooltip, Mode=OneWay}"
                                       FontFamily="{StaticResource MonoFont}"
                                       FontSize="13"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       HorizontalAlignment="Center" />
                            <TextBlock Grid.Column="2"
                                       Text="{x:Bind ViewModel.LiveEtaText, Mode=OneWay}"
                                       FontFamily="{StaticResource MonoFont}"
                                       FontSize="13"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       HorizontalAlignment="Right" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 3. Always-Visible Results Card (Stretches to fill remaining window height) -->
                <Border x:Name="MatchesCard"
                        Grid.Row="2"
                        Style="{StaticResource SurfaceCardStyle}"
                        Padding="14,10"
                        MinHeight="68"
                        VerticalAlignment="Stretch">
                    <Grid>
                        <StackPanel x:Name="NoMatchesEmptyPanel"
                                    Spacing="4"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <TextBlock x:Name="NoMatchesEmptyText"
                                       Text="{x:Bind ViewModel.Loc.NoResults, Mode=OneWay}"
                                       FontSize="13"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center" />
                            <TextBlock x:Name="TraySpeedupHintTextBlock"
                                       Text="{x:Bind ViewModel.TraySpeedupHintText, Mode=OneWay}"
                                       FontSize="11.5"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                       Opacity="0.82"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       Visibility="Collapsed" />
                        </StackPanel>

                        <Grid x:Name="MatchesContentGrid"
                              RowDefinitions="Auto,*"
                              RowSpacing="8"
                              Visibility="Collapsed">
                            <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0"
                                           Text="{x:Bind ViewModel.MatchesCount, Mode=OneWay}"
                                           FontFamily="{StaticResource MonoFont}"
                                           FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           VerticalAlignment="Center" />
                                <Button Grid.Column="1"
                                        Content="{x:Bind ViewModel.Loc.ClearAll, Mode=OneWay}"
                                        FontSize="12"
                                        Padding="8,3"
                                        Click="OnClearAllMatchesClick" />
                            </Grid>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{x:Bind ViewModel.Matches}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Spacing="8" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:MatchedKeyItemViewModel">
                                            <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="6">
                                                <TextBlock Grid.Column="0"
                                                           Text="{x:Bind FormattedKeyId}"
                                                           FontFamily="{StaticResource MonoFont}"
                                                           FontSize="14"
                                                           FontWeight="SemiBold"
                                                           VerticalAlignment="Center" />

                                                <Button Grid.Column="1"
                                                        Style="{StaticResource IconGhostButtonStyle}"
                                                        ToolTipService.ToolTip="{x:Bind Loc.Copy, Mode=OneWay}"
                                                        AutomationProperties.Name="{x:Bind Loc.Copy, Mode=OneWay}"
                                                        Tag="{x:Bind Fingerprint}"
                                                        Click="OnCopyFingerprintClick">
                                                    <FontIcon Glyph="&#xE8C8;" FontSize="13" />
                                                </Button>

                                                <Button Grid.Column="2"
                                                        Content=".asc"
                                                        FontFamily="{StaticResource MonoFont}"
                                                        FontSize="12"
                                                        Padding="10,4"
                                                        Tag="{x:Bind Record}"
                                                        Click="OnExportMatchClick" />

                                                <Button Grid.Column="3"
                                                        Style="{StaticResource IconGhostButtonStyle}"
                                                        ToolTipService.ToolTip="{x:Bind Loc.DeleteKeyTooltip, Mode=OneWay}"
                                                        AutomationProperties.Name="{x:Bind Loc.DeleteKeyTooltip, Mode=OneWay}"
                                                        Tag="{x:Bind Record}"
                                                        Click="OnDeleteMatchClick">
                                                    <FontIcon Glyph="&#xE74D;" FontSize="13" />
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

        </Grid>
    </Grid>
</Window>
