<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <FontFamily x:Key="MonoFont">DejaVu Sans Mono, Liberation Mono, Noto Sans Mono, Cascadia Mono, Consolas, Monospace</FontFamily>
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="AppWindowBg" Color="#F3F4F6" />
      <SolidColorBrush x:Key="CardSurfaceBg" Color="#FFFFFF" />
      <SolidColorBrush x:Key="CardSurfaceBorder" Color="#E2E5EB" />
      <SolidColorBrush x:Key="SubtleSurfaceBg" Color="#EDEFF3" />
      <SolidColorBrush x:Key="SubtleSurfaceHoverBg" Color="#E1E5EC" />
      <SolidColorBrush x:Key="SubtleSurfaceBorder" Color="#D7DCE4" />
      <SolidColorBrush x:Key="TextSecondaryBrush" Color="#5A6372" />
      <SolidColorBrush x:Key="TextTertiaryBrush" Color="#7A8394" />
      <SolidColorBrush x:Key="DividerLineBrush" Color="#E5E8EE" />
      <SolidColorBrush x:Key="ErrorBannerBg" Color="#1FEF4444" />
      <SolidColorBrush x:Key="ErrorBannerBorder" Color="#88EF4444" />
      <SolidColorBrush x:Key="AccentButtonBg" Color="#0A66C2" />
      <SolidColorBrush x:Key="AccentButtonHoverBg" Color="#0857A6" />
      <SolidColorBrush x:Key="AccentButtonDisabledBg" Color="#750A66C2" />
      <SolidColorBrush x:Key="AccentButtonFg" Color="#FFFFFF" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="Dark">
      <SolidColorBrush x:Key="AppWindowBg" Color="#1E1F23" />
      <SolidColorBrush x:Key="CardSurfaceBg" Color="#27292F" />
      <SolidColorBrush x:Key="CardSurfaceBorder" Color="#373A43" />
      <SolidColorBrush x:Key="SubtleSurfaceBg" Color="#31343C" />
      <SolidColorBrush x:Key="SubtleSurfaceHoverBg" Color="#3B3F4A" />
      <SolidColorBrush x:Key="SubtleSurfaceBorder" Color="#424652" />
      <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A0A8B8" />
      <SolidColorBrush x:Key="TextTertiaryBrush" Color="#7C8596" />
      <SolidColorBrush x:Key="DividerLineBrush" Color="#353842" />
      <SolidColorBrush x:Key="ErrorBannerBg" Color="#28EF4444" />
      <SolidColorBrush x:Key="ErrorBannerBorder" Color="#88EF4444" />
      <SolidColorBrush x:Key="AccentButtonBg" Color="#2563EB" />
      <SolidColorBrush x:Key="AccentButtonHoverBg" Color="#1D4ED8" />
      <SolidColorBrush x:Key="AccentButtonDisabledBg" Color="#752563EB" />
      <SolidColorBrush x:Key="AccentButtonFg" Color="#FFFFFF" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
